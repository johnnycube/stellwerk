{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "customManagers:makefileVersions",
    "customManagers:githubActionsVersions"
  ],
  "pre-commit": { "enabled": true },
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "Matrix encryption: one PR, never automerged, the e2e test must pass",
      "matchPackageNames": ["maunium.net/go/mautrix", "go.mau.fi/**"],
      "groupName": "mautrix",
      "automerge": false,
      "labels": ["matrix"]
    },
    {
      "description": "Small and safe: actions and patch releases",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": { "enabled": true, "labels": ["security"] }
}
