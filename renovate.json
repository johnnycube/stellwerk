{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Matrix encryption: one PR, never automerged, the e2e test must pass",
      "matchPackageNames": [
        "maunium.net/go/mautrix",
        "go.mau.fi/**"
      ],
      "groupName": "mautrix",
      "automerge": false,
      "labels": [
        "matrix"
      ]
    },
    {
      "description": "Small and safe: actions and patch releases",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "minimumReleaseAge": "3 days"
}
